# Copy to backend/.env; never commit the real keys.
# Imported model profiles have blank keys: edit them in the homepage configuration panel.
LLM_PROVIDER=custom
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL_ID=your-model-id
LLM_API_KEY=
LLM_TIMEOUT=120
LLM_MAX_TOKENS=8192

# Configure Tavily for network research; chat does not need a search key.
SEARCH_API=tavily
TAVILY_API_KEY=
SEARCH_MAX_ATTEMPTS=2
SEARCH_RETRY_DELAY=0.5
SEARCH_FALLBACK_APIS=
MAX_WEB_RESEARCH_LOOPS=3
FETCH_FULL_PAGE=True
ENABLE_NOTES=True
NOTES_WORKSPACE=./notes
